# voya local development
PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000
JSON_BODY_LIMIT=1mb

# Optional AI keys. Leave empty to use deterministic mock AI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYA_MOCK_AI=true
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_OPUS_MODEL=claude-opus-4-7
MODEL_PROVIDER_TIMEOUT_MS=60000
MAX_INPUT_CHARS=50000
MAX_OUTPUT_TOKENS=2000

# Supabase scaffold for future auth and persistence.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
