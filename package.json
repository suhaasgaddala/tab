{
  "name": "tab",
  "version": "0.1.0",
  "description": "Tab: the spend layer for AI agents on an existing x402 router backbone.",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "preview:frontend": "npm --prefix frontend run preview",
    "build:all": "npm run build && npm run build:frontend",
    "demo:tab": "tsx examples/run-tab.ts",
    "demo:tab:budget": "tsx examples/run-tab.ts --scenario budget",
    "buyer:market-signal": "tsx examples/buyer-market-signal.ts",
    "buyer:model-call": "tsx examples/buyer-model-call.ts"
  },
  "keywords": [
    "x402",
    "agentic",
    "llm",
    "inference",
    "gateway"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@coinbase/x402": "^2.1.0",
    "@supabase/supabase-js": "^2.105.4",
    "@x402/core": "^2.10.0",
    "@x402/evm": "^2.10.0",
    "@x402/express": "^2.10.0",
    "@x402/extensions": "^2.10.0",
    "@x402/fetch": "^2.10.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.18",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
